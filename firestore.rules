rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getProjectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && (
        request.auth.uid in getProjectData(projectId).memberIds ||
        request.auth.uid == getProjectData(projectId).ownerId
      );
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && request.auth.uid == getProjectData(projectId).ownerId;
    }

    // ──────────────────────────────────────────
    // 1. Users collection
    // ──────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read user profile
      allow read: if isAuthenticated();
      // Only the user themselves can create or update their profile
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ──────────────────────────────────────────
    // 2. Projects collection
    // ──────────────────────────────────────────
    match /projects/{projectId} {
      // Any authenticated user can create a project with themselves as owner
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Project members or owner can read project details
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.ownerId == request.auth.uid
      );

      // Members or owner can update project (e.g. member joins or project settings)
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid == resource.data.ownerId
      );

      // Only owner can delete project
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // ── Subcollection: Bills ────────────────
      match /bills/{billId} {
        allow read, create, update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      // ── Subcollection: Settlements ─────────
      match /settlements/{settlementId} {
        allow read, create, update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }
    }

    // ──────────────────────────────────────────
    // 3. Share Invites collection (6-char code)
    // ──────────────────────────────────────────
    match /share_invites/{inviteCode} {
      // Authenticated users can look up an invite code to join a project
      allow read: if isAuthenticated();
      // Any authenticated project member can create an invite
      allow create: if isAuthenticated();
      // Only creator or project owner can update/deactivate invite
      allow update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isProjectOwner(resource.data.projectId)
      );
    }
  }
}
